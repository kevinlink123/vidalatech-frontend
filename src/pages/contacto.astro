---
import Layout from '../layouts/Layout.astro';

const budgetOptions = [
  { value: "N/A", label: "N/A Prefiero no divulgarlo todavía" },
  { value: 'menos-1000', label: 'Menos de USD 1.000' },
  { value: '1000-3000', label: 'USD 1.000 a USD 3.000' },
  { value: '3000-5000', label: 'USD 3.000 a USD 5.000' },
  { value: '5000-10000', label: 'USD 5.000 a USD 10.000' },
  { value: '10000-20000', label: 'USD 10.000 a USD 20.000' },
  { value: '20000-30000', label: 'USD 20.000 a USD 30.000' },
  { value: 'mas-30000', label: 'Más de USD 30.000' }
];

const industryOptions = [
  { value: 'ecommerce', label: 'E-commerce / Retail' },
  { value: 'tecnologia', label: 'Tecnología / SaaS' },
  { value: 'salud', label: 'Salud / Healthcare' },
  { value: 'finanzas', label: 'Finanzas / Fintech' },
  { value: 'educacion', label: 'Educación / EdTech' },
  { value: 'inmobiliaria', label: 'Inmobiliaria / Real Estate' },
  { value: 'logistica', label: 'Logística / Transporte' },
  { value: 'medios', label: 'Medios / Entretenimiento' },
  { value: 'gastronomia', label: 'Gastronomía / Hotelería' },
  { value: 'servicios', label: 'Servicios Profesionales' },
  { value: 'construccion', label: 'Construcción / Arquitectura' },
  { value: 'agro', label: 'Agro / Agroindustria' },
  { value: 'otro', label: 'Otro' }
];

const faqs = [
  {
    question: '¿Cuánto tiempo lleva desarrollar un proyecto?',
    answer: 'Depende de la complejidad y el alcance. Un proyecto web típico puede llevar entre 6 y 16 semanas. Durante la primera reunión evaluamos tu caso específico y te damos un cronograma detallado con hitos claros para que sepas exactamente cuándo tendrás tu producto funcionando.'
  },
  {
    question: '¿Cómo es el proceso de trabajo con Vidala Tech?',
    answer: 'Trabajamos en 4 etapas: 1) Discovery: entendemos tu negocio y definimos requerimientos. 2) Planificación: diseñamos la arquitectura y armamos un roadmap. 3) Desarrollo: sprints iterativos de 2 semanas con demos regulares para que veas el avance. 4) Lanzamiento: deploy, testing final y capacitación si es necesaria. Todo con comunicación constante y transparencia total.'
  },
  {
    question: '¿Ofrecen soporte y mantenimiento después del lanzamiento?',
    answer: 'Sí, todos nuestros proyectos incluyen un período de garantía de 3 meses para corregir cualquier bug o ajuste que surja. Luego ofrecemos planes de mantenimiento mensual que incluyen monitoreo, backups, actualizaciones de seguridad y mejoras continuas. La idea es ser partners tecnológicos a largo plazo, no solo desarrollar y desaparecer.'
  }
];
---

<Layout title="Contacto">
  <!-- Modal -->
  <div id="modal" class="backdrop hidden flex justify-center items-center h-screen w-full bg-black/40 fixed top-20 z-10">
    <div class="text-container p-8 w-1/2 bg-gray-50 rounded-2xl">
      <h3 class="title text-2xl font-bold text-red-500">ERROR</h3>
      <h4 id="error-text" class="error-text"></h4>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="pt-32 pb-20 px-4 sm:px-6 lg:px-8 bg-gray-50">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="text-5xl md:text-6xl font-bold mb-6 text-gray-900">
        ¿Tenés un proyecto <span class="text-primary">en mente</span>?
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Contanos sobre tu idea y te ayudaremos a transformarla en una solución digital a medida. 
        Completá el formulario y te respondemos en 24-48 hs hábiles.
      </p>
    </div>
  </section>

  <!-- Formulario y Proceso -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-3 gap-12">
        
        <!-- Formulario (2/3) -->
        <div class="lg:col-span-2">
          <form 
            action="/api/contacto" 
            method="POST"
            class="space-y-6"
            id="contactForm"
          >
            <!-- Nombre y Email -->
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-semibold text-gray-900 mb-2">
                  Nombre completo *
                </label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required
                  placeholder="Ej: Carlos Rodríguez"
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-white text-gray-900 placeholder-gray-400"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-semibold text-gray-900 mb-2">
                  Email *
                </label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required
                  placeholder="Ej: carlos@empresa.com"
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-white text-gray-900 placeholder-gray-400"
                />
              </div>
            </div>

            <!-- Teléfono y Presupuesto -->
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="phone" class="block text-sm font-semibold text-gray-900 mb-2">
                  Teléfono
                </label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone"
                  placeholder="Ej: +54 11 1234-5678"
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-white text-gray-900 placeholder-gray-400"
                />
              </div>
              <div>
                <label for="budget" class="block text-sm font-semibold text-gray-900 mb-2">
                  Presupuesto estimado *
                </label>
                <select 
                  id="budget" 
                  name="budget" 
                  required
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-white text-gray-900"
                >
                  <option value="" disabled selected class="text-gray-400">Seleccioná un rango</option>
                  {budgetOptions.map(option => (
                    <option value={option.value}>{option.label}</option>
                  ))}
                </select>
              </div>
            </div>

            <!-- Industria -->
            <div>
              <label for="industry" class="block text-sm font-semibold text-gray-900 mb-2">
                Industria *
              </label>
              <select 
                id="industry" 
                name="industry" 
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-white text-gray-900"
              >
                <option value="" disabled selected class="text-gray-400">Seleccioná tu industria</option>
                {industryOptions.map(option => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </div>

            <!-- Mensaje -->
            <div>
              <label for="message" class="block text-sm font-semibold text-gray-900 mb-2">
                Dejanos saber cómo podemos ayudarte *
              </label>
              <textarea 
                id="message" 
                name="message" 
                rows="6"
                required
                placeholder="Contanos sobre tu proyecto, objetivos, funcionalidades que necesitás, o cualquier detalle que consideres relevante..."
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-white text-gray-900 placeholder-gray-400 resize-y"
              ></textarea>
            </div>

            <!-- Submit -->
            <button
              type="submit"
              class="w-full sm:w-auto px-8 py-4 bg-primary hover:bg-primary-dark text-white font-medium rounded-lg transition-colors text-lg flex items-center justify-center space-x-2"
            >
              <span>Enviar consulta</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>

            <p class="text-sm text-gray-500 mt-4">
              * Campos requeridos. Tus datos son confidenciales y solo los usaremos para responder tu consulta.
            </p>
          </form>
        </div>

        <!-- Sidebar: Info de contacto y proceso (1/3) -->
        <div class="space-y-8">
          <!-- Contacto directo -->
          <div class="p-8 rounded-xl bg-gray-50 border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-6">Contacto directo</h3>
            
            <div class="space-y-4">
              <a 
                href="mailto:kevin_link_23@hotmail.com"
                class="flex items-center space-x-3 text-gray-600 hover:text-primary transition-colors"
              >
                <div class="w-10 h-10 bg-primary-lighter rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <span>kevin_link_23@hotmail.com</span>
              </a>

              <a 
                href="https://wa.me/541122618594"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center space-x-3 text-gray-600 hover:text-primary transition-colors"
              >
                <div class="w-10 h-10 bg-primary-lighter rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </div>
                <span>+54 11 2261-8594</span>
              </a>
            </div>
          </div>

          <!-- Proceso -->
          <div class="p-8 rounded-xl bg-primary-lighter border border-primary/20">
            <h3 class="text-xl font-bold text-gray-900 mb-6">¿Qué pasa después?</h3>
            
            <div class="space-y-4">
              <div class="flex items-start space-x-3">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold shrink-0">1</div>
                <div>
                  <p class="text-sm font-semibold text-gray-900">Revisamos tu consulta</p>
                  <p class="text-sm text-gray-600">Analizamos tu proyecto y preparamos preguntas</p>
                </div>
              </div>
              <div class="flex items-start space-x-3">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold shrink-0">2</div>
                <div>
                  <p class="text-sm font-semibold text-gray-900">Coordinamos una reunión</p>
                  <p class="text-sm text-gray-600">30-45 min para entender tu negocio</p>
                </div>
              </div>
              <div class="flex items-start space-x-3">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold shrink-0">3</div>
                <div>
                  <p class="text-sm font-semibold text-gray-900">Te enviamos una propuesta</p>
                  <p class="text-sm text-gray-600">Presupuesto, timeline y alcance detallado</p>
                </div>
              </div>
              <div class="flex items-start space-x-3">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold shrink-0">4</div>
                <div>
                  <p class="text-sm font-semibold text-gray-900">Arrancamos el proyecto</p>
                  <p class="text-sm text-gray-600">Kick-off y primer sprint en marcha</p>
                </div>
              </div>
            </div>

            <p class="text-sm text-gray-500 mt-4 pt-4 border-t border-primary/20">
              ⏱ Tiempo de respuesta: 24-48 hs hábiles
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-gray-50">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold mb-4 text-gray-900">Preguntas Frecuentes</h2>
        <p class="text-xl text-gray-600">
          Todo lo que necesitás saber antes de comenzar
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, index) => (
          <div class="border border-gray-200 rounded-xl bg-white overflow-hidden">
            <button 
              class="w-full px-6 py-5 text-left flex items-center justify-between hover:bg-gray-50 transition-colors"
              onclick={`this.parentElement.querySelector('.faq-answer').classList.toggle('hidden'); this.querySelector('.faq-icon').classList.toggle('rotate-45');`}
            >
              <span class="text-lg font-semibold text-gray-900 pr-4">{faq.question}</span>
              <span class="faq-icon text-primary text-2xl transition-transform duration-300 shrink-0">+</span>
            </button>
            <div class="faq-answer hidden px-6 pb-5">
              <p class="text-gray-600 leading-relaxed">{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-8">
        <p class="text-gray-600">
          ¿Tenés otra pregunta?{' '}
          <a
            data-umami-event="contacto-wpp" 
            target="_blank"
            href="https://api.whatsapp.com/send?phone=541122618594&text=Hola%2C%20tengo%20algunas%20dudas%20sobre%20el%20servicio." class="text-primary hover:text-primary-dark font-medium transition-colors">
            Hablemos
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-primary-lighter">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold mb-4 text-gray-900">
        ¿Listo para dar el primer paso?
      </h2>
      <p class="text-xl mb-8 text-gray-600">
        No importa si tenés una idea clara o solo un concepto inicial. 
        Estamos para ayudarte a darle forma y convertirla en un producto digital exitoso.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          data-umami-event="contacto-proyectos"
          href="/proyectos"
          class="inline-flex items-center justify-center px-8 py-4 border-2 border-primary text-primary hover:bg-white font-medium rounded-lg transition-all"
        >
          Ver proyectos realizados
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { umami } from "../utils/tracking";
  const API_URL = import.meta.env.PUBLIC_BACKEND_URL || "http://localhost";
  const PORT = import.meta.env.PUBLIC_PORT || "";

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById('contactForm') as HTMLFormElement;
    const modal = document.getElementById("modal");

    modal?.addEventListener("click", () => {
      modal.classList.toggle("hidden");
      modal.getElementsByClassName("error-text")[0].textContent = "";
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());
      
      try {
        const response = await fetch(`${API_URL}:${PORT}/api/contact`, {
          method: "POST",
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if(!response.ok) {
          throw new Error(result.message || 'Error al enviar el formulario');
        }

        umami.track("contacto-submit");
        alert('¡Gracias por tu consulta! Te responderemos en 24-48 hs hábiles.');
        form.reset();
      } catch(err: any) {
        modal!.classList.toggle("hidden")
        const errorText = document.getElementById("error-text");
        errorText!.textContent = err.message;
      }
    });
  });
</script>