---
import { Image } from 'astro:assets';
import '../styles/global.css';
// import logo from '../assets/devops.png';
// import logo from '../assets/Vidala-Tech-Logo.png';
import Layout from '../layouts/Layout.astro';
import projects from '../data/projects.json';

const services = [
  {
    icon: "code",
    title: "Digitalización de Procesos",
    description: "Transformamos tus procesos manuales u obsoletos en plataformas web a medida. Automatizamos flujos de trabajo, centralizamos datos y eliminamos planillas de Excel para que tu operación escale sin fricciones."
  },
  {
    icon: "zap",
    title: "Sistemas Centralizados",
    description: "Unificamos la información y las herramientas dispersas de tu empresa en un único hub de gestión. Integramos tus sistemas actuales y creamos dashboards inteligentes para que tomes decisiones basadas en datos en tiempo real."
  },
  {
    icon: "shield",
    title: "Calidad Empresarial",
    description: "Aplicamos los mismos estándares de código, seguridad y rendimiento que usan las grandes tecnológicas, pero pensados para la agilidad y el presupuesto de tu empresa. Soluciones robustas, mantenibles y listas para crecer."
  }
];

const competencies = [
  "Web Dev",
  "Mobile Dev",
  "API Dev",
  "DevOps/Cloud",
  "Database Design",
];
---
<Layout title='Home Page'>
  <!-- Hero Section -->
  <section class="pt-32 pb-20 px-4 sm:px-6 lg:px-8 bg-[url(../assets/bg-hero.webp)] bg-cover bg-bottom bg-fixed bg-no-repeat relative overflow-hidden z-0">
    <div class="absolute inset-0 bg-linear-to-r from-white/50 from-20% to-transparent -z-10"></div>
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl">
        <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight text-gray-900">
          Desarrollamos plataformas digitales que
          <span class="text-primary">transforman negocios</span>
        </h1>
        <p class="text-xl mb-8 text-gray-900 font-bold tracking-wider">
          Soluciones profesionales creadas desde cero con tecnologías modernas.
          Especialistas en NestJS, React y arquitecturas escalables.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            data-umami-event="homepage-hero-contacto"
            href="/contacto"
            class="inline-flex items-center justify-center px-8 py-4 bg-primary hover:bg-primary-dark text-white font-medium rounded-lg transition-colors"
          >
            Iniciar proyecto
            <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a
            data-umami-event="homepage-hero-proyectos"
            href="/proyectos"
            class="inline-flex items-center justify-center px-8 py-4 border-2 border-primary text-primary hover:bg-primary-lighter font-medium rounded-lg transition-all"
          >
            Ver proyectos
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="nosotros" class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <!-- Left Column: Content -->
        <div>
          <h2 class="text-4xl font-bold mb-6 text-gray-900">
            Software Factory especializada en soluciones digitales
          </h2>
          <p class="text-lg text-gray-600 mb-6 leading-relaxed">
            En Vidala Tech tomamos procesos de negocio complejos, manuales o obsoletos y los convertimos en <strong>herramientas web o mobile a medida, centralizadas y de alto rendimiento</strong>. No importa si es logística, salud, finanzas o e-commerce, combinamos experiencia técnica con un enfoque práctico para entregar plataformas digitales robustas y escalables.
          </p>
          <p class="text-lg text-gray-600 mb-8 leading-relaxed">
            Construimos cada proyecto con <strong class="text-gray-900">arquitecturas escalables</strong> que crecen con tu negocio, utilizando tecnologías modernas y mejores prácticas de la industria.
          </p>

          <div class="space-y-4">
            <div class="flex items-start space-x-4">
              <div class="shrink-0 w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-gray-900 mb-1">Metodologías Ágiles</h3>
                <p class="text-gray-600">Trabajamos con sprints y entregas iterativas para mantener flexibilidad y transparencia en cada proyecto.</p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="shrink-0 w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-gray-900 mb-1">Integración Continua</h3>
                <p class="text-gray-600">Implementamos CI/CD para desplegar cambios rápidamente con ciclos de trabajo cortos y bien definidos.</p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="shrink-0 w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-gray-900 mb-1">Calidad Garantizada</h3>
                <p class="text-gray-600">Testing automatizado y code reviews para asegurar código limpio, mantenible y libre de bugs críticos.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Stats/Highlights -->

          <div class="bg-primary/5 p-8 rounded-2xl border-2 border-primary/20">
            <h3 class="text-xl font-bold mb-4 text-gray-900">Nuestro Proceso</h3>
            <div class="space-y-3">
              <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">1</div>
                <span class="text-gray-700">Descubrimiento y analisis de requerimientos</span>
              </div>
              <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">2</div>
                <span class="text-gray-700">Planificacion y definicion de procesos</span>
              </div>
              <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">3</div>
                <span class="text-gray-700">Diseño de arquitectura y estandares</span>
              </div>
              <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">4</div>
                <span class="text-gray-700">Desarrollo iterativo en sprints ágiles</span>
              </div>
              <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">5</div>
                <span class="text-gray-700">Testing y QA continuo</span>
              </div>
              <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">6</div>
                <span class="text-gray-700">Deploy y soporte post-lanzamiento</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="servicios" class="py-20 px-4 sm:px-6 lg:px-8 bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-4 text-gray-900">Servicios</h2>
        <p class="text-xl text-gray-600">
          Desarrollo de soluciones digitales end-to-end
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {services.map((service) => (
          <div class="observable p-8 rounded-xl bg-white border border-gray-200 hover:shadow-lg transition-all lg:duration-700 duration-1000 ease-out translate-y-10 opacity-0">
            <div class="text-primary mb-4">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                {service.icon === 'code' && <path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/>}
                {service.icon === 'zap' && <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>}
                {service.icon === 'shield' && <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>}
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3 text-gray-900">
              {service.title}
            </h3>
            <p class="text-gray-600">
              {service.description}
            </p>
          </div>
        ))}
      </div>
      <div class="our-premise-container mt-14">
        <h2 class="text-xl text-gray-600">
          <strong> Nuestro enfoque:</strong> <i> "Escuchamos tu problema de negocio, diseñamos una solución a medida y desarrollamos una 
          plataforma robusta. No vendemos horas de código, construimos el sistema que ordena y potencia tu 
          empresa."</i>
        </h2>
      </div>
    </div>
  </section>

  <!-- Competencies Section -->
  <section id="competencias" class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-gray-900 overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-4">Competencias</h2>
        <p class="text-xl text-gray-600">
          Soluciones digitales completas de principio a fin
        </p>
      </div>

      <!-- Scrolling competencies banner -->
      <div class="relative">
        <div class="flex animate-scroll space-x-8 mb-8">
          {competencies.concat(competencies).concat(competencies).concat(competencies).concat(competencies).map((comp, idx) => (
            <div class="shrink-0 px-8 py-4 bg-primary-light backdrop-blur-sm rounded-lg border border-white/20 hover:bg-white/20 transition-all">
              <span class="text-xl font-semibold whitespace-nowrap">{comp}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Experience highlights -->
      <div class="mt-16 grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="text-5xl font-bold text-primary mb-2">7+</div>
          <div class="text-gray-300">Años de experiencia en la industria IT</div>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold text-primary mb-2">Full Stack</div>
          <div class="text-gray-300">Frontend, Backend, DevOps</div>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold text-primary mb-2">Enterprise</div>
          <div class="text-gray-300">Código de calidad profesional</div>
        </div>
      </div>
    </div>
  </section>

  <style>
    @keyframes scroll {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-100%);
      }
    }

    .animate-scroll {
      animation: scroll 25s linear infinite;
    }

    .animate-scroll:hover {
      animation-play-state: paused;
    }
  </style>

  <!-- Projects Section -->
  <section id="proyectos" class="py-20 px-4 sm:px-6 lg:px-8 bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-4 text-gray-900">Proyectos Destacados</h2>
        <p class="text-xl text-gray-600">
          Soluciones reales para problemas reales
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {projects.map((project) => (
          <a href={`/proyectos/${project.slug}`} class="group block p-8 rounded-xl bg-white border border-gray-200 hover:shadow-xl hover:border-primary transition-all">
            <h3 class="text-2xl font-bold mb-3 text-gray-900 group-hover:text-primary transition-colors">
              {project.title}
            </h3>
            <p class="mb-6 text-gray-600">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              {project.technologies.map((tag) => (
                <span class="px-3 py-1 rounded-full text-sm font-medium text-primary bg-primary-lighter">
                  {tag}
                </span>
              ))}
            </div>
            <div class="flex items-center text-primary font-medium group-hover:gap-2 transition-all">
              Ver caso de estudio
              <svg class="w-5 h-5 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contacto" class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold mb-4 text-gray-900">
        ¿Tenés un proyecto en mente?
      </h2>
      <p class="text-xl mb-12 text-gray-600">
        Conversemos sobre cómo podemos ayudarte a construir tu próxima plataforma digital
      </p>

      <div class="inline-flex flex-col sm:flex-row gap-4 mb-12">
        <a
          data-umami-event="homepage-endsection-contacto"
          href="/contacto"
          class="inline-flex items-center justify-center px-8 py-4 bg-primary hover:bg-primary-dark text-white font-medium rounded-lg transition-colors"
        >
          Ponete en contacto con nosotros
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
    // Crea un nuevo IntersectionObserver
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        // Si el elemento está en el viewport, quita la clase que lo oculta
        if (entry.isIntersecting) {
          entry.target.classList.remove('translate-y-10', 'opacity-0');
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.4
    });

    document.querySelectorAll('.observable').forEach(el => {
      observer.observe(el);
    });
  });

    // Smooth scrolling for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
		//@ts-ignore
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  </script>
</body>
</html>
