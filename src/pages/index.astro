---
import { Image } from 'astro:assets';
import '../styles/global.css';
import logo from '../assets/devops.png';

const services = [
  {
    icon: "code",
    title: "Desarrollo de Plataformas",
    description: "Creamos plataformas robustas desde cero con NestJS, React y tecnologías modernas. Soluciones escalables diseñadas para tu negocio."
  },
  {
    icon: "zap",
    title: "Arquitectura Moderna",
    description: "Implementamos arquitecturas basadas en contenedores, microservicios y cloud-native. Infraestructura que crece con tu empresa."
  },
  {
    icon: "shield",
    title: "Soluciones Enterprise",
    description: "Desarrollos profesionales con altos estándares de calidad, seguridad y rendimiento. Código limpio y mantenible."
  }
];

const competencies = [
  "Web Dev",
  "Mobile Dev",
  "API Dev",
  "DevOps/Cloud",
  "Database Design",
];

const projects = [
  {
    name: "WCloud",
    slug: "wcloud",
    description: "Plataforma de hosting completa con gestión de contenedores Docker, proxy reverso Traefik y sistema de correos corporativos.",
    tags: ["Web Dev", "API Dev", "DevOps/Cloud"]
  },
  {
    name: "Plataformas Personalizadas",
    slug: "custom-platforms",
    description: "Desarrollamos soluciones digitales a medida para resolver problemas específicos de tu negocio.",
    tags: ["Web Dev", "Mobile Dev", "API Dev"]
  }
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="KY Cloud - Desarrollo de plataformas digitales profesionales con NestJS, React y Astro">
  <title>KY Cloud - Soluciones Digitales Profesionales</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

</head>
<body class="bg-main-white text-gray-900">
  <!-- Navigation -->
  <nav class="fixed w-full bg-white/95 backdrop-blur-sm border-b border-gray-200 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <a href="#" class="flex items-center space-x-2">
          <div class="w-10 h-10 p-1.5 rounded bg-primary">
			<Image src={logo} alt="KY Logo" />
		  </div>
          <span class="text-xl font-bold text-gray-900">KY Cloud</span>
        </a>

        <!-- Desktop Menu -->
        <div class="hidden md:flex items-center space-x-8">
          <a href="#servicios" class="text-gray-600 hover:text-primary transition-colors">Servicios</a>
          <a href="#competencias" class="text-gray-600 hover:text-primary transition-colors">Competencias</a>
          <a href="#proyectos" class="text-gray-600 hover:text-primary transition-colors">Proyectos</a>
          <a href="#contacto" class="px-6 py-2 bg-primary hover:bg-primary-dark text-white rounded-lg transition-colors">
            Contacto
          </a>
        </div>

        <!-- Mobile Menu Button -->
        <button class="md:hidden text-gray-900" id="menuBtn">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div class="hidden md:hidden border-t border-gray-200 bg-white" id="mobileMenu">
      <div class="px-4 py-4 space-y-3">
        <a href="#servicios" class="block py-2 text-gray-600">Servicios</a>
        <a href="#competencias" class="block py-2 text-gray-600">Competencias</a>
        <a href="#proyectos" class="block py-2 text-gray-600">Proyectos</a>
        <a href="#contacto" class="block py-2 text-primary font-medium">Contacto</a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="pt-32 pb-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl">
        <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight text-gray-900">
          Desarrollamos plataformas digitales que
          <span class="text-primary">transforman negocios</span>
        </h1>
        <p class="text-xl mb-8 text-gray-600">
          Soluciones profesionales creadas desde cero con tecnologías modernas.
          Especialistas en NestJS, React y arquitecturas escalables.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="#contacto"
            class="inline-flex items-center justify-center px-8 py-4 bg-primary hover:bg-primary-dark text-white font-medium rounded-lg transition-colors"
          >
            Iniciar proyecto
            <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a
            href="#proyectos"
            class="inline-flex items-center justify-center px-8 py-4 border-2 border-primary text-primary hover:bg-primary-lighter font-medium rounded-lg transition-all"
          >
            Ver proyectos
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="servicios" class="py-20 px-4 sm:px-6 lg:px-8 bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-4 text-gray-900">Servicios</h2>
        <p class="text-xl text-gray-600">
          Desarrollo de soluciones digitales end-to-end
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {services.map((service) => (
          <div class="p-8 rounded-xl bg-white border border-gray-200 hover:shadow-lg transition-shadow">
            <div class="text-primary mb-4">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                {service.icon === 'code' && <path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/>}
                {service.icon === 'zap' && <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>}
                {service.icon === 'shield' && <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>}
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3 text-gray-900">
              {service.title}
            </h3>
            <p class="text-gray-600">
              {service.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Competencies Section -->
  <section id="competencias" class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-gray-900 overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-4">Competencias</h2>
        <p class="text-xl text-gray-600">
          Soluciones digitales completas de principio a fin
        </p>
      </div>

      <!-- Scrolling competencies banner -->
      <div class="relative">
        <div class="flex animate-scroll space-x-8 mb-8">
          {competencies.concat(competencies).concat(competencies).map((comp, idx) => (
            <div class="shrink-0 px-8 py-4 bg-primary-light backdrop-blur-sm rounded-lg border border-white/20 hover:bg-white/20 transition-all">
              <span class="text-xl font-semibold whitespace-nowrap">{comp}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Experience highlights -->
      <div class="mt-16 grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="text-5xl font-bold text-primary mb-2">7+</div>
          <div class="text-gray-300">Años de experiencia en la industria IT</div>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold text-primary mb-2">Full Stack</div>
          <div class="text-gray-300">Frontend, Backend, DevOps</div>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold text-primary mb-2">Enterprise</div>
          <div class="text-gray-300">Código de calidad profesional</div>
        </div>
      </div>
    </div>
  </section>

  <style>
    @keyframes scroll {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-33.333%);
      }
    }

    .animate-scroll {
      animation: scroll 20s linear infinite;
    }

    .animate-scroll:hover {
      animation-play-state: paused;
    }
  </style>

  <!-- Projects Section -->
  <section id="proyectos" class="py-20 px-4 sm:px-6 lg:px-8 bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-4 text-gray-900">Proyectos Destacados</h2>
        <p class="text-xl text-gray-600">
          Soluciones reales para problemas reales
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {projects.map((project) => (
          <a href={`/proyectos/${project.slug}`} class="group block p-8 rounded-xl bg-white border border-gray-200 hover:shadow-xl hover:border-primary transition-all">
            <h3 class="text-2xl font-bold mb-3 text-gray-900 group-hover:text-primary transition-colors">
              {project.name}
            </h3>
            <p class="mb-6 text-gray-600">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              {project.tags.map((tag) => (
                <span class="px-3 py-1 rounded-full text-sm font-medium text-primary bg-primary-lighter">
                  {tag}
                </span>
              ))}
            </div>
            <div class="flex items-center text-primary font-medium group-hover:gap-2 transition-all">
              Ver caso de estudio
              <svg class="w-5 h-5 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contacto" class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold mb-4 text-gray-900">
        ¿Tenés un proyecto en mente?
      </h2>
      <p class="text-xl mb-12 text-gray-600">
        Conversemos sobre cómo podemos ayudarte a construir tu próxima plataforma digital
      </p>

      <div class="inline-flex flex-col sm:flex-row gap-4 mb-12">
        <a
          href="mailto:contacto@kycloud.com"
          class="inline-flex items-center justify-center px-8 py-4 bg-primary hover:bg-primary-dark text-white font-medium rounded-lg transition-colors"
        >
          <svg class="mr-2 w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          contacto@kycloud.com
        </a>
      </div>

      <div class="flex justify-center space-x-6">
        <a href="#" class="text-primary hover:opacity-70 transition-opacity">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
        <a href="#" class="text-primary hover:opacity-70 transition-opacity">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-8 px-4 border-t border-gray-200 bg-gray-50">
    <div class="max-w-7xl mx-auto text-center">
      <p class="text-gray-600">
        © 2024 KY Cloud. Soluciones digitales profesionales.
      </p>
      <p class="mt-2 text-sm text-gray-600">
        Buenos Aires, Argentina
      </p>
    </div>
  </footer>

  <script>
    // Mobile menu toggle
    const menuBtn = document.getElementById('menuBtn')!;
    const mobileMenu = document.getElementById('mobileMenu')!;

    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    // Smooth scrolling for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
		//@ts-ignore
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          mobileMenu.classList.add('hidden');
        }
      });
    });
  </script>
</body>
</html>
