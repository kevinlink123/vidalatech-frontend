---
export interface Props {
  title: string;
  description: string;
  category: string;
  technologies: string[];
  image: string;
  liveUrl?: string;
  githubUrl?: string;
}

const { title, description, category, technologies, image, liveUrl, githubUrl } = Astro.props;

const categoryLabel = {
  'desarrollo-web': 'Desarrollo Web',
  'desarrollo-mobile': 'Desarrollo Mobile'
}[category] || category;
---

<div class="group relative overflow-hidden rounded-xl bg-neutral-800/50 border border-red-500/20 hover:border-red-500 transition-all duration-300 hover:shadow-[0_0_25px_rgba(239,68,68,0.15)]">
  <!-- Imagen del proyecto -->
  <div class="relative h-48 overflow-hidden">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
      loading="lazy"
    />
    <!-- Overlay con categoría -->
    <div class="absolute top-4 left-4">
      <span class="px-3 py-1 rounded-full text-xs font-medium bg-red-500/20 text-red-400 border border-red-500/30 backdrop-blur-sm">
        {categoryLabel}
      </span>
    </div>
  </div>

  <!-- Contenido -->
  <div class="p-6">
    <h3 class="text-xl font-bold text-white mb-3 group-hover:text-red-400 transition-colors">
      {title}
    </h3>
    <p class="text-neutral-400 mb-4 line-clamp-3 leading-relaxed">
      {description}
    </p>
    
    <!-- Tecnologías -->
    <div class="flex flex-wrap gap-2 mb-6">
      {technologies.map((tech) => (
        <span class="px-2 py-1 text-xs rounded-full bg-neutral-700 text-neutral-300 border border-neutral-600">
          {tech}
        </span>
      ))}
    </div>

    <!-- Botones de acción -->
    <div class="flex gap-3">
      {liveUrl && (
        <a 
          href={liveUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex-1 text-center px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-medium transition-all hover:shadow-[0_0_20px_rgba(239,68,68,0.3)]"
        >
          🌐 Demo en vivo
        </a>
      )}
      {githubUrl && (
        <a 
          href={githubUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex-1 text-center px-4 py-2 bg-neutral-700 hover:bg-neutral-600 text-white rounded-lg text-sm font-medium transition-all border border-neutral-600 hover:border-neutral-500"
        >
          💻 Ver código
        </a>
      )}
    </div>
    {!liveUrl && !githubUrl && (
      <p class="text-center text-sm text-neutral-500 italic">Proyecto privado</p>
    )}
  </div>
</div>